Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^ads/([a-z0-9-]+)/?$ ads/index.php?slug=$1 [QSA,L]
RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [QSA,L]
RewriteRule ^(word|truth|spirit|publications|commitments|contact)/?$ $1.php [L]
</IfModule>

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
